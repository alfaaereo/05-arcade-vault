# Copia este archivo a .env.local y rellena RESEND_API_KEY.
# Solo se leen en el servidor (sin prefijo NEXT_PUBLIC_).
RESEND_API_KEY=
CONTACT_TO_EMAIL=alfaaereo@gmail.com
# onboarding@resend.dev solo entrega al dueño de la cuenta de Resend.
# Con un dominio verificado, usa una dirección de ese dominio.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Supabase. Son públicas: van en el bundle del cliente. Usa la publishable key
# (sb_publishable_…), nunca la secret key ni la service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
